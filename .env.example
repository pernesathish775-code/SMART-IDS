# Copy this file to .env and fill in real values.
# Never commit .env to version control.

SECRET_KEY=replace-with-a-long-random-string

# Email alerts
MAIL_ENABLED=false
MAIL_SMTP_SERVER=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SENDER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_RECEIVER=receiver@example.com

# Face recognition (0.55 = good default, lower = stricter)
FACE_THRESHOLD=0.55

# Seconds between duplicate detection events
EVENT_COOLDOWN=10

# Webcam index (0 = default laptop webcam)
CAMERA_INDEX=0

# Process every Nth frame to reduce CPU load
PROCESS_EVERY_N_FRAMES=3
